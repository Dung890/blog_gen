# Copy this file to .env and fill in your real values.

# --- Required ---
# Get a key at https://console.groq.com
GROQ_API_KEY=""

# --- Optional: model & generation tuning ---
# Chat model to use. Options for a typical key: openai/gpt-oss-20b (default,
# fast), openai/gpt-oss-120b (higher quality), qwen/qwen3.8-27b.
GROQ_MODEL="openai/gpt-oss-20b"
# Max output tokens per call. Groq's FREE tier caps you at 8000 tokens/minute,
# and a request costs (input + max_tokens). 1500 keeps the full
# title -> content -> translate flow under that limit. Raise it if you upgrade.
GROQ_MAX_TOKENS="1500"
# Reasoning effort for gpt-oss models: low | medium | high. Keep it low so the
# output budget goes to text, not hidden reasoning.
GROQ_REASONING_EFFORT="low"

# --- Optional: LangSmith tracing ---
LANGCHAIN_PROJECT=""
LANGCHAIN_API_KEY=""
